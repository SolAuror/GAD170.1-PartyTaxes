<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the game scripts outside Unity against minimal API stubs (Stubs/) and runs
    behaviour checks on the core rules (Program.cs). A stopgap until Unity EditMode tests exist.
    Run from the repo root with dotnet run and the project path Tools/HeadlessTests (see Program.cs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0649;CS0169;CS0067;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs/*.cs" />
    <Compile Include="../../Assets/PartyTaxes/Scripts/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
